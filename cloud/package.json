{
  "name": "myresume-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy",
    "build:node": "node node/build.mjs",
    "test:node": "node --import tsx --test node/node.test.ts",
    "dev:free": "wrangler dev --config wrangler-free.toml --port 8788",
    "deploy:free": "wrangler deploy --config wrangler-free.toml",
    "dry-run:free": "wrangler deploy --config wrangler-free.toml --dry-run --outdir .wrangler/dry-run-free",
    "test:free-adapter": "node --import tsx --test free/sqlite-d1.test.ts free/request-admission.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261103.0-beta",
    "wrangler": "4.157.0"
  }
}
