worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    types {
        text/html html htm;
        text/css css;
        application/javascript js mjs;
        application/json json map;
        image/svg+xml svg;
        image/png png;
        image/jpeg jpg jpeg;
        image/webp webp;
        image/x-icon ico;
        font/ttf ttf;
        font/otf otf;
        font/woff woff;
        font/woff2 woff2;
        application/wasm wasm;
        application/pdf pdf;
        text/plain txt md;
    }
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    etag on;
    keepalive_timeout 30;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml font/ttf application/wasm;

    server {
        listen __PORT__;
        server_name _;
        root __DEPLOY_ROOT__/current;
        index index.html;
        charset utf-8;

        location = /healthz {
            access_log off;
            default_type text/plain;
            add_header Cache-Control "no-store" always;
            return 200 "ok\n";
        }
        location = /index.html {
            add_header Cache-Control "no-cache, must-revalidate" always;
            try_files $uri =404;
        }
        location ^~ /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }
        location ^~ /fonts/ {
            add_header Cache-Control "public, max-age=0, must-revalidate" always;
            try_files $uri =404;
        }
        location ^~ /pdf-assets/ {
            add_header Cache-Control "public, max-age=0, must-revalidate" always;
            try_files $uri =404;
        }
        location ~ /\. {
            deny all;
        }
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
