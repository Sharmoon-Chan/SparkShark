{
  "name": "myresume",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/setup-pdf-assets.mjs && vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/setup-pdf-assets.mjs && tsc -b && vite build",
    "build:cloud": "npm run build && node scripts/prepare-cloud-assets.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "verify:pdf": "tsx scripts/verify-pdf.ts",
    "fixtures:docx": "tsx scripts/docx-import-fixtures.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "buffer": "6.0.3",
    "dexie": "4.4.7",
    "fflate": "0.8.3",
    "lucide-react": "^1.66.0",
    "mammoth": "1.13.0",
    "parse5": "8.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.3",
    "unified": "^11.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.23",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
